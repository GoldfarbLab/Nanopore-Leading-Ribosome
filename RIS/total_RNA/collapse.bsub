#!/bin/bash
#BSUB -g LSF_g
#BSUB -G LSF_G
#BSUB -a 'docker(brookslab/flair:latest)'
#BSUB -J collapse[1-24]
#BSUB -q general
#BSUB -n 8
#BSUB -M 64G
#BSUB -W 600
#BSUB -R 'span[hosts=1]'
#BSUB -o LSF_LOG_PATH/collapse.%J.%I.out.txt
#BSUB -e LSF_LOG_PATH/collapse.%J.%I.err.txt

source LSF_SCRIPT_PATH/config.sh

# Make output directory
mkdir -p ${RESULTS_PATH}/collapse/chrom

# Run flair collapse on each chromsome
COUNTER=0
for CHROM_BED in ${RESULTS_PATH}/split/*.bed; do
    if [ -f "$CHROM_BED" ]; then
        if [ $((${COUNTER}%24)) == $((${LSB_JOBINDEX}-1)) ]; then
            CHROM=$(basename -- "$CHROM_BED")
            CHROM=${CHROM%.*}
            echo "Processing chromosome: " $CHROM
            # --stringent --isoformtss --no_gtf_end_adjustment --no_redundant longest  --filter nosubset --trust_ends
            # using recommended settings for novel isoform detection in yeast as written in the FLAIR manual; the latest annotation has UTR information included so may preclude the need for isoformTSS/TES
            # Another reason is that we are unlikely to see the 5' end of the transcript in the polysome reads so it is unclear if defining the TSS is helpful. It is also unclear how FLAIR handles GTFs with the full length transcripts included but the TSS/TES options not defined
            # also unclear if better to use the no_gtf_end_adjustment option or not since we want to be stringent about isoforms
            flair collapse -g ${GENOME} --threads 8 --gtf ${RESULTS_PATH}/split/${CHROM}.gtf -q ${CHROM_BED} --output ${RESULTS_PATH}/collapse/chrom/${CHROM} -r ${RESULTS_PATH}/reads/combined.reads.gz --check_splice --stringent --generate_map --annotation-reliant generate --trust_ends --no_gtf_end_adjustment
        fi
        COUNTER=$[$COUNTER +1]
    fi
done

