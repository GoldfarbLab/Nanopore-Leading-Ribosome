#!/bin/bash
#BSUB -g LSF_g
#BSUB -G LSF_G
#BSUB -a 'docker(brookslab/flair:latest)'
#BSUB -J align[1-10]
#BSUB -q general
#BSUB -n 8
#BSUB -M 128G
#BSUB -W 120
#BSUB -R 'span[hosts=1]'
#BSUB -o LSF_LOG_PATH/align.%J.%I.out.txt
#BSUB -e LSF_LOG_PATH/align.%J.%I.err.txt

source LSF_SCRIPT_PATH/config.sh

# Make output directory
mkdir -p ${RESULTS_PATH}/bed/

bam2Bed12 -i {RESULTS_PATH}/align/${DATA_BASE_NAME}_genome_aligned.bam > ${RESULTS_PATH}/bed/${DATA_BASE_NAME}_genome_aligned.bed
flair correct -g ${GENOME} -q ${RESULTS_PATH}/bed/${DATA_BASE_NAME}_genome_aligned.bed --threads 8 -j ${INTRONS} --gtf ${ANNOTATIONS} --output ${RESULTS_PATH}/align/${DATA_BASE_NAME}
